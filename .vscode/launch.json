{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Cortex Debug",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/f.elf",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "openocd",
            "gdbPath": "/home/vovan/mySTM/arm-gnu-toolchain-14.2.rel1-x86_64-arm-none-eabi/bin/arm-none-eabi-gdb",
            "serverpath": "openocd",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f3x.cfg"
            ]
        },
        {
            "name": "gdbDebug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${input:elf_file}",
            "args": [],
            "stopAtEntry": true,
            "cwd":  "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "/home/vovan/mySTM/arm-gnu-toolchain-14.2.rel1-x86_64-arm-none-eabi/bin/arm-none-eabi-gdb",
            "miDebuggerServerAddress": "localhost:3333",
            "setupCommands": [
                {
                    "description": "Pretty print for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "svdPath": "${workspaceFolder}/STM32F303.svd"
        }
    ],
    "inputs": [
        {
            "id": "elf_file",
            "type": "promptString",
            "description": "Enter the path of the ELF file to be debugged",
        }
    ]
}
